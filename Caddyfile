{
	admin off
	auto_https off
	persist_config off
}

:{$PORT} {
	@health path /health
	handle @health {
		rewrite * /
		reverse_proxy {$FIRECRAWL_API_URL}
	}

	@admin path /admin/{$BULL_AUTH_KEY}/*
	handle @admin {
		reverse_proxy {$FIRECRAWL_API_URL}
	}

	@authorized {
		header Authorization "Bearer {$FIRECRAWL_API_KEY}"
	}
	@wsauthorized {
		header Sec-WebSocket-Protocol {$FIRECRAWL_API_KEY}
	}
	handle @authorized {
		reverse_proxy {$FIRECRAWL_API_URL}
	}
	handle @wsauthorized {
		reverse_proxy {$FIRECRAWL_API_URL}
	}

	handle {
		header Content-Type application/json
		header WWW-Authenticate "Bearer"
		respond `{"success":false,"error":"Unauthorized: send Authorization: Bearer <FIRECRAWL_API_KEY>"}` 401
	}
}
